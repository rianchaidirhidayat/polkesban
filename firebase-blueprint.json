{
  "entities": {
    "LivePortal": {
      "title": "LivePortal",
      "description": "Publicly published microsite menus and company profile",
      "type": "object",
      "properties": {
        "menus": {
          "type": "array",
          "description": "List of active published menu items"
        },
        "profile": {
          "type": "object",
          "description": "Microsite profile metadata and styling"
        },
        "lastPublishedAt": {
          "type": "string",
          "description": "ISO timestamp of last publish"
        }
      },
      "required": ["menus", "profile"]
    },
    "ClickLog": {
      "title": "ClickLog",
      "description": "Analytics click log for menu items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "menuId": { "type": "string" },
        "menuTitle": { "type": "string" },
        "category": { "type": "string" },
        "timestamp": { "type": "string" },
        "device": { "type": "string" },
        "browser": { "type": "string" },
        "referrer": { "type": "string" }
      },
      "required": ["id", "menuId", "menuTitle", "timestamp"]
    },
    "WfaSubmission": {
      "title": "WfaSubmission",
      "description": "Pengajuan WFA Bimbingan dosen dan pegawai Poltekkes Kemenkes Bandung",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nip": { "type": "string" },
        "employeeName": { "type": "string" },
        "unitKerja": { "type": "string" },
        "jabatan": { "type": "string" },
        "tanggalWfa": { "type": "string" },
        "namaKegiatan": { "type": "string" },
        "lokasiKegiatan": { "type": "string" },
        "statusWfa": { "type": "string" },
        "linkSuratTugas": { "type": "string" },
        "status": { "type": "string" },
        "catatanPengelola": { "type": "string" },
        "createdAt": { "type": "string" },
        "validatedAt": { "type": "string" },
        "validatedBy": { "type": "string" }
      },
      "required": ["id", "nip", "employeeName", "tanggalWfa", "namaKegiatan", "lokasiKegiatan", "statusWfa", "linkSuratTugas", "status", "createdAt"]
    }
  },
  "firestore": {
    "/portal/live": {
      "schema": "LivePortal",
      "description": "Live published portal state synced across all devices"
    },
    "/click_logs/{logId}": {
      "schema": "ClickLog",
      "description": "Click event logs"
    },
    "/wfa_submissions/{submissionId}": {
      "schema": "WfaSubmission",
      "description": "Pengajuan WFA bimbingan pegawai dan status validasi pengelola"
    }
  }
}
